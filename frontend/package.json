{
  "name": "frontend-paul",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prod": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "prettier:format": "prettier --config prettier.config.mjs --write src/**/*.{ts,tsx}",
    "prettier:check": "prettier --config prettier.config.mjs --check src/**/*.{ts,tsx}",
    "i18n:scan": "i18next-scanner --config i18next-scanner.config.cjs",
    "i18n:generate-types": "i18next-resources-for-ts interface -i src/locales -o src/types/i18n.d.ts -c \"This file is generated automatically by i18next-resources-for-ts\"",
    "i18n:check-missing": "node scripts/i18n/check-missing.cjs",
    "i18n:validate": "node scripts/i18n/validate.cjs",
    "i18n:export-csv": "node scripts/i18n/export-csv.cjs",
    "i18n:import-csv": "node scripts/i18n/import-csv.cjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.1.1",
    "@inertiajs/react": "^2.0.13",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.522.0",
    "nuqs": "^2.4.3",
    "react": "^19.1.0",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.61.0",
    "react-i18next": "^15.5.3",
    "sanitize-html": "^2.17.0",
    "sonner": "^2.0.6",
    "superstruct": "^2.0.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "zod": "^4.0.8",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/lodash": "^4.17.18",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "i18next-resources-for-ts": "^1.6.0",
    "i18next-scanner": "^4.6.0",
    "prettier": "^3.6.2",
    "tw-animate-css": "^1.3.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
